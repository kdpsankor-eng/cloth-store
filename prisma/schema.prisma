// Prisma Schema for Premium Women's Fashion E-commerce (Bangladesh)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("ADMIN") // SUPER_ADMIN, ADMIN, STAFF
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  nameBn       String
  slug         String     @unique
  description  String?
  imageUrl     String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  parentId     String?
  parent       Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children     Category[] @relation("SubCategories")
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Product {
  id                    String           @id @default(cuid())
  name                  String
  nameBn                String
  slug                  String           @unique
  sku                   String           @unique
  description           String
  descriptionBn         String?
  regularPrice          Float
  salePrice             Float?
  isFeatured            Boolean          @default(false)
  isActive              Boolean          @default(true)
  hasSizeVariants       Boolean          @default(false)
  sizeSelectionRequired Boolean          @default(false)
  availableSizes        String?          // Comma-separated default sizes e.g. "36, 38, 40, 42, 44"
  seoTitle              String?
  seoDescription        String?
  
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  
  images                ProductImage[]
  variants              ProductVariant[]
  orderItems            OrderItem[]
  
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isThumbnail  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String      @unique
  size            String?
  color           String?
  stockQuantity   Int         @default(0)
  priceAdjustment Float       @default(0.0)
  isActive        Boolean     @default(true)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Order {
  id               String               @id @default(cuid())
  orderNumber      String               @unique // e.g. WCS-261024-XXXX
  customerName     String
  customerPhone    String
  deliveryAddress  String
  deliveryZone     String               // INSIDE_DHAKA, OUTSIDE_DHAKA
  orderNotes       String?
  subtotal         Float
  deliveryCharge   Float
  discountAmount   Float                @default(0.0)
  totalPayable     Float
  orderStatus      String               @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, RETURNED, DELIVERY_FAILED
  paymentMethod    String               @default("CASH_ON_DELIVERY")
  paymentStatus    String               @default("UNPAID") // UNPAID, PAID, REFUNDED
  courierName      String?
  trackingCode     String?
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  productNameSnapshot String
  variantNameSnapshot String?
  unitPriceSnapshot   Float
  quantity            Int
  lineTotal           Float
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  notes     String?
  changedBy String?  @default("System")
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  targetEntity String
  details      String?  // JSON string
  ipAddress    String?
  createdAt    DateTime @default(now())
}
